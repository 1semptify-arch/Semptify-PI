# Copy this file to .env and fill in synthetic values only.
# Never use real Semptify tenant tokens or OAuth credentials here.

# Mock Core settings
MOCK_CORE_HOST=127.0.0.1
MOCK_CORE_PORT=9000

# Plugin config (example only)
SEMPIFY_PI_PLUGIN_TOKEN=pl_change_me
SEMPIFY_PI_CORE_URL=http://127.0.0.1:9000

# Core token and containment settings
SEMPIFY_PI_PLUGIN_TOKEN_DAYS=90
SEMPIFY_PI_PROVIDER_TOKEN_MINUTES=30
SEMPIFY_PI_VAULT_FOLDER=/Semptify5.0/Inbox

# Provider OAuth credentials (Brad-only, Phase 3)
# Never commit real values; set these in Render env vars or local .env.
SEMPIFY_PI_GOOGLE_CLIENT_ID=
SEMPIFY_PI_GOOGLE_CLIENT_SECRET=
SEMPIFY_PI_GOOGLE_REDIRECT_URI=http://127.0.0.1:9000/auth/google/callback

SEMPIFY_PI_DROPBOX_CLIENT_ID=
SEMPIFY_PI_DROPBOX_CLIENT_SECRET=
SEMPIFY_PI_DROPBOX_REDIRECT_URI=http://127.0.0.1:9000/auth/dropbox/callback

SEMPIFY_PI_ONEDRIVE_CLIENT_ID=
SEMPIFY_PI_ONEDRIVE_CLIENT_SECRET=
SEMPIFY_PI_ONEDRIVE_REDIRECT_URI=http://127.0.0.1:9000/auth/onedrive/callback

# Local PostgreSQL 16 for agent/tests
# The agent uses this for the task orchestrator and any scratch work.
# It is separate from Semptify Core's production database.
DATABASE_URL=postgresql+asyncpg://semptify_pi:CHANGE_ME@localhost:5432/semptify_pi
