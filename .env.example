# Copy this file to .env and fill in synthetic values only.
# Never use real Semptify tenant tokens or OAuth credentials here.

# Mock Core settings
MOCK_CORE_HOST=127.0.0.1
MOCK_CORE_PORT=9000

# Plugin config (example only)
SEMPIFY_PI_PLUGIN_TOKEN=pl_change_me
SEMPIFY_PI_CORE_URL=http://127.0.0.1:9000

# Local PostgreSQL 16 for agent/tests
# The agent uses this for the task orchestrator and any scratch work.
# It is separate from Semptify Core's production database.
DATABASE_URL=postgresql+asyncpg://semptify_pi:CHANGE_ME@localhost:5432/semptify_pi
